# mexicosquared (sitio público) — variables de entorno
#
# Sprint 1: NEXT_PUBLIC_API_BASE_URL apunta al backend AdonisJS.
# Sprint 2: agregamos NEXT_PUBLIC_TURNSTILE_SITE_KEY (DIFERIDA a Sprint 7,
#   en Sprint 2-6 el form funciona sin el widget gracias al stub del backend).

# Backend público
NEXT_PUBLIC_API_BASE_URL=http://localhost:3333/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:5173

# Información de contacto fallback (opcional)
NEXT_PUBLIC_GABANA_PHONE=
NEXT_PUBLIC_GABANA_WHATSAPP=
NEXT_PUBLIC_GABANA_EMAIL=hola@gabanarealstate.com.mx

# Social
NEXT_PUBLIC_GABANA_INSTAGRAM=
NEXT_PUBLIC_GABANA_FACEBOOK=
NEXT_PUBLIC_GABANA_TIKTOK=

# Sprint 2 — Cloudflare Turnstile (DIFERIDO a Sprint 7)
# Cuando exista el sitio en Cloudflare Turnstile, pega aquí el Site Key
# y el widget invisible se monta automáticamente en el LeadForm. Mientras
# tanto, dejarlo vacío hace que el form omita el widget y el backend
# acepta el payload con el stub mockeado del turnstile_service.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
